<?xml version="1.0" encoding="utf-8"?>
<!--
  =============================================================================
  OpenS100 : common compiler settings shared by every project

  Every .vcxproj imports this file immediately after importing
  Microsoft.Cpp.props. Project specific ItemDefinitionGroup elements appear
  later in each .vcxproj, so a project that sets the same property explicitly
  still wins.

  [ Why /utf-8 is set here ]

  Without this option MSVC interprets source files that have no BOM using the
  system ANSI code page, which is CP949 on a Korean Windows installation.
  As a result:

    * Build output depends on the locale of the developer machine. The same
      commit compiles differently on Korean Windows and on English Windows.
    * Non-ASCII characters in files stored as UTF-8 without a BOM are silently
      corrupted. No warning and no error is produced.

  /utf-8 pins both the source charset and the execution charset to UTF-8,
  which removes that dependency: the same binary is produced regardless of the
  locale the build runs under.

  See also: CONVENTIONS.md ("Source encoding")
  =============================================================================
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    The viewer draws with Skia (Documents/TechDocs/2026-11-24-r7-viewer-on-skia-design.md): the
    manifest install of every project asks for the "render-skia" feature of vcpkg.json. Every
    project asks for the same, so that they agree on what vcpkg_installed holds.
  -->
  <PropertyGroup>
    <VcpkgAdditionalInstallOptions>--x-feature=render-skia $(VcpkgAdditionalInstallOptions)</VcpkgAdditionalInstallOptions>
  </PropertyGroup>
  <!--
    vcpkg installs again only when vcpkg.json or vcpkg-configuration.json is newer than its
    stamp. The option above is in this file, so this file counts as well: a checkout that was
    built before the option was here installs Skia on its next build.
  -->
  <ItemGroup>
    <_ZVcpkgInstallManifestDependenciesInputs Include="$(MSBuildThisFileFullPath)" />
  </ItemGroup>
  <!--
    What a file that includes Skia headers needs: the definitions Skia was built with (those of
    the unofficial-skia CMake package; they differ between debug and release) and its include
    root (Skia headers are included as "include/core/...").
  -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>SK_CODEC_DECODES_BMP;SK_CODEC_DECODES_WBMP;SK_ENABLE_PRECOMPILE;SK_GANESH;SK_GAMMA_APPLY_TO_A8;SK_ENABLE_AVX512_OPTS;SK_TYPEFACE_FACTORY_DIRECTWRITE;SK_FONTMGR_DIRECTWRITE_AVAILABLE;SK_FONTMGR_GDI_AVAILABLE;SK_CODEC_DECODES_ICO;SK_CODEC_DECODES_PNG;SK_CODEC_DECODES_PNG_WITH_LIBPNG;SK_CODEC_ENCODES_PNG;SK_CODEC_ENCODES_PNG_WITH_LIBPNG;SK_TYPEFACE_FACTORY_FREETYPE;SK_FONTMGR_ANDROID_AVAILABLE;SK_FONTMGR_FREETYPE_DIRECTORY_AVAILABLE;SK_FONTMGR_FREETYPE_EMBEDDED_AVAILABLE;SK_FONTMGR_FREETYPE_EMPTY_AVAILABLE;SK_SUPPORT_XPS;SK_HAS_WUFFS_LIBRARY;SK_CODEC_DECODES_GIF;SK_XML;SK_ALLOW_STATIC_GLOBAL_INITIALIZERS=1;SK_ENABLE_DUMP_GPU;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'!='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>SK_CODEC_DECODES_BMP;SK_CODEC_DECODES_WBMP;SK_ENABLE_PRECOMPILE;SK_GANESH;SK_GAMMA_APPLY_TO_A8;SK_ENABLE_AVX512_OPTS;SK_TYPEFACE_FACTORY_DIRECTWRITE;SK_FONTMGR_DIRECTWRITE_AVAILABLE;SK_FONTMGR_GDI_AVAILABLE;SK_CODEC_DECODES_ICO;SK_CODEC_DECODES_PNG;SK_CODEC_DECODES_PNG_WITH_LIBPNG;SK_CODEC_ENCODES_PNG;SK_CODEC_ENCODES_PNG_WITH_LIBPNG;SK_TYPEFACE_FACTORY_FREETYPE;SK_FONTMGR_ANDROID_AVAILABLE;SK_FONTMGR_FREETYPE_DIRECTORY_AVAILABLE;SK_FONTMGR_FREETYPE_EMBEDDED_AVAILABLE;SK_FONTMGR_FREETYPE_EMPTY_AVAILABLE;SK_SUPPORT_XPS;SK_HAS_WUFFS_LIBRARY;SK_CODEC_DECODES_GIF;SK_XML;SK_DISABLE_TRACING;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <!--
        Skia's include root (its headers are included as "include/core/..."), as an external
        directory: its headers are not held to the warnings of this code.
      -->
      <AdditionalOptions>/utf-8 /external:I "$(VcpkgManifestRoot)\vcpkg_installed\$(VcpkgTriplet)\$(VcpkgTriplet)\include\skia" /external:W0 %(AdditionalOptions)</AdditionalOptions>
      <!--
        /std:c++20 implies /permissive-. Every project conforms since Phase 1 step 4-1
        (Documents/TechDocs/2026-11-08-phase1-core-decoupling.md); keep it that way.
      -->
      <ConformanceMode>true</ConformanceMode>
      <!--
        Newer vcpkg libxml2 ports install headers under include/libxml2/libxml/...; older
        installs used include/libxml/... directly. Add the sub-directory so <libxml/parser.h>
        resolves either way (the directory is simply ignored when it does not exist).

        The vcpkg luajit port installs its headers under include/luajit; the Lua scripting
        module and its host include <lua.hpp>.
      -->
      <AdditionalIncludeDirectories>$(VcpkgManifestRoot)\vcpkg_installed\$(VcpkgTriplet)\$(VcpkgTriplet)\include\libxml2;$(VcpkgManifestRoot)\vcpkg_installed\$(VcpkgTriplet)\$(VcpkgTriplet)\include\luajit;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
