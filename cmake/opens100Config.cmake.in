@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(GeographicLib CONFIG)
if(@OPENS100_BUILD_FEATURECATALOG@)
    find_dependency(pugixml CONFIG)
    find_dependency(utf8cpp CONFIG)
endif()
if(@OPENS100_BUILD_SYSTEMDATABASE@)
    find_dependency(unofficial-sqlite3 CONFIG)
    find_dependency(pugixml CONFIG)
    find_dependency(OpenSSL)
    find_dependency(ZLIB)
endif()

if(@OPENS100_BUILD_COVERAGE@ OR @OPENS100_BUILD_DATASET@)
    find_dependency(hdf5 CONFIG)
endif()
if(@OPENS100_BUILD_DATASET@)
    find_dependency(pugixml CONFIG)
    find_dependency(polyclipping CONFIG)
    find_dependency(Boost)
endif()
if(@OPENS100_BUILD_PORTRAYAL@)
    find_dependency(LibXml2)
    find_dependency(LibXslt)
endif()
if(@OPENS100_BUILD_RENDER_SKIA@)
    find_dependency(unofficial-skia CONFIG)
endif()
if(@OPENS100_BUILD_LUASCRIPTING@)
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(LuaJIT)
    list(REMOVE_AT CMAKE_MODULE_PATH -1)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/opens100Targets.cmake")

check_required_components(opens100)
